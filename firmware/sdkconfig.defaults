# Waveshare ESP32-S3-Relay-6CH, ESP-IDF v6.1
CONFIG_IDF_TARGET="esp32s3"

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: roll back to the previous image if a new one never reports healthy
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Save crash dumps to flash for post-mortem debugging (idf.py coredump-info)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# HTTP server: browsers send large headers; basic auth adds more
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# MQTT over TLS uses the built-in CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
